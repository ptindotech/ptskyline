# Default local admin credentials used by the CMS login.
# Change these before deployment and keep the real values in the environment, not in source control.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=MendozerAdmin!2026

# Canonical public URL. Use the production hostname in production and staging hostname in previews.
NEXT_PUBLIC_SITE_URL=https://ptskyline.vercel.app

# Search ownership verification tokens from Google Search Console and Bing Webmaster Tools.
# These are safe public verification values, but keep the actual values in Vercel environment settings.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional public WhatsApp control. Leave empty until a verified public number is approved.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Approved server-side Resend delivery configuration.
# These values are server-only. Never prefix them with NEXT_PUBLIC and never commit credentials.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=info@skyline.co.id
